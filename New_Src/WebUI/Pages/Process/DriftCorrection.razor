@page "/process/drift"
@using WebUI.Services
@inject AuthService AuthService
@inject ProjectService ProjectService
@inject DriftService DriftService
@inject PivotService PivotService
@inject CorrectionService CorrectionService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>ICP - Drift Correction</PageTitle>

<NavigationLock OnBeforeInternalNavigation="OnBeforeNavigation" ConfirmExternalNavigation="@(_isLoading || _isApplying)" />

@if (_isLoading || _isApplying)
{
    <div class="loading-overlay">
        <MudPaper Elevation="4" Class="pa-6 d-flex flex-column align-center">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Class="mt-4">Processing...</MudText>
        </MudPaper>
    </div>
}

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="0" Class="pa-4 mb-4 custom-card-all">
        <div class="justify-space-between align-center">
            <div class="mb-4">
                <MudText Typo="Typo.h4" Class="fw-bold h4-title">Drift Correction</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary p-description">
                    @if (!string.IsNullOrEmpty(_projectName))
                    {
                        <span>Project: <strong>@_projectName</strong> | </span>
                    }
                    RM-based drift analysis and correction
                </MudText>
            </div>
            <ProcessNav CurrentStep="drift" />
        </div>
    </MudPaper>

    @if (_projectId == null)
    {
        <MudAlert Severity="Severity.Warning">Please select a project first.</MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="5">
                <MudPaper Elevation="0" Class="pa-4 custom-card-all">
                    <MudText Typo="Typo.h6" Class="mb-3">Controls</MudText>

                    <MudTextField T="string"
                                  Label="Keyword"
                                  Variant="Variant.Outlined"
                                  Value="_keyword"
                                  ValueChanged="OnKeywordChanged"
                                  Class="mb-2" />

                    <MudStack Row="true" Spacing="1" Class="mb-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   OnClick="AnalyzeDrift"
                                   Disabled="@(_isLoading || _isApplying || string.IsNullOrWhiteSpace(_focusElement))">
                            Check RM Changes
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   OnClick="UndoLastCorrection"
                                   Disabled="@(_isLoading || _isApplying)">
                            Undo Last Correction
                        </MudButton>
                    </MudStack>

                    <MudCheckBox T="bool"
                                 @bind-Value="_applyStepwiseChanges"
                                 Dense="true"
                                 Label="Apply Stepwise Changes"
                                 Class="mb-2" />

                    <MudTextField T="string"
                                  Label="Filter Solution Labels"
                                  Variant="Variant.Outlined"
                                  Value="_solutionFilter"
                                  ValueChanged="OnSolutionFilterChanged"
                                  Immediate="true"
                                  Class="mb-2" />

                    <MudStack Row="true" Spacing="1" Class="mb-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   OnClick="AutoOptimizeToFlat"
                                   Disabled="@(!HasAnalysis || _rmRatioRows.Count == 0)">
                            Auto Optimize to Flat
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   OnClick="AutoOptimizeSlopeToZero"
                                   Disabled="@(!HasAnalysis || _rmRatioRows.Count == 0)">
                            Auto Optimize Slope to Zero
                        </MudButton>
                    </MudStack>

                    <MudStack Row="true" Spacing="2" Class="mb-2">
                        <MudCheckBox T="bool" @bind-Value="_globalOptimizeIgnoreChecks" Dense="true" Label="Global Optimize (Ignore Checks)" />
                        <MudCheckBox T="bool" @bind-Value="_perFileRmReference" Dense="true" Label="Per File RM Reference" />
                    </MudStack>

                    <MudSelect T="DriftMethod"
                               Value="_method"
                               ValueChanged="(v) => _method = v"
                               Label="Method"
                               Variant="Variant.Outlined"
                               Class="mb-2">
                        <MudSelectItem Value="DriftMethod.Linear">Linear</MudSelectItem>
                        <MudSelectItem Value="DriftMethod.Stepwise">Stepwise</MudSelectItem>
                    </MudSelect>

                    <MudSelect T="string"
                               Value="_focusElement"
                               ValueChanged="OnFocusElementChanged"
                               Label="Element"
                               Variant="Variant.Outlined"
                               Class="mb-2">
                        @foreach (var element in _allElements)
                        {
                            <MudSelectItem Value="@element">@element</MudSelectItem>
                        }
                    </MudSelect>

                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudButton Variant="Variant.Outlined" OnClick="PrevRm" Disabled="@(!CanPrevRm)">Previous</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="NextRm" Disabled="@(!CanNextRm)">Next</MudButton>
                        <MudText Typo="Typo.body2">@CurrentRmText</MudText>
                    </MudStack>

                    <MudDivider Class="my-2" />

                    <MudText Typo="Typo.subtitle2" Class="mb-1">RM Points and Ratios</MudText>
                    <MudTable Items="_rmRatioRows" Dense="true" Hover="true" FixedHeader="true" Height="200px" Breakpoint="Breakpoint.None" HorizontalScrollbar="true">
                        <HeaderContent>
                            <MudTh>RM Label</MudTh>
                            <MudTh>Next RM</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Original Value</MudTh>
                            <MudTh>Current Value</MudTh>
                            <MudTh>Ratio</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.RmLabel</MudTd>
                            <MudTd>@context.NextRmLabel</MudTd>
                            <MudTd>@context.Type</MudTd>
                            <MudTd>@context.OriginalValue.ToString("F3")</MudTd>
                            <MudTd>@context.CurrentValue.ToString("F3")</MudTd>
                            <MudTd>@context.Ratio.ToString("F3")</MudTd>
                        </RowTemplate>
                    </MudTable>

                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Data Between Selected RM Points</MudText>
                    <MudTable Items="_betweenRows" Dense="true" Hover="true" FixedHeader="true" Height="200px" Breakpoint="Breakpoint.None" HorizontalScrollbar="true">
                        <HeaderContent>
                            <MudTh>Solution Label</MudTh>
                            <MudTh>Original Value</MudTh>
                            <MudTh>Corrected Value</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.SolutionLabel</MudTd>
                            <MudTd>@context.OriginalValue.ToString("F3")</MudTd>
                            <MudTd>@context.CorrectedValue.ToString("F3")</MudTd>
                        </RowTemplate>
                    </MudTable>

                    <MudPaper Elevation="0" Class="pa-3 mt-3">
                        <MudText Typo="Typo.subtitle2">Slope Optimization</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">Current Slope: @_currentSlope.ToString("F6")</MudText>
                        <MudNumericField T="decimal"
                                         Label="Adjust Slope"
                                         Variant="Variant.Outlined"
                                         Value="_targetSlope"
                                         ValueChanged="OnTargetSlopeChanged"
                                         Class="mb-2" />
                        <MudStack Row="true" Spacing="1">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="RotateUp" Disabled="@(!HasAnalysis)">Rotate Up</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="RotateDown" Disabled="@(!HasAnalysis)">Rotate Down</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ResetToOriginal" Disabled="@(!HasAnalysis)">Reset to Original</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="7">
                <MudPaper Elevation="0" Class="pa-4 custom-card-all">
                    @if (!HasAnalysis)
                    {
                        <MudAlert Severity="Severity.Info">Run "Check RM Changes" to build RM plot and drift diagnostics.</MudAlert>
                    }
                    else
                    {
                        <MudGrid Class="mb-3">
                            <MudItem xs="6" md="3">
                                <MudPaper Elevation="0" Class="pa-2 text-center" Style="background: var(--mud-palette-info-lighten);">
                                    <MudText Typo="Typo.h6">@_analysisResult!.TotalSamples</MudText>
                                    <MudText Typo="Typo.caption">Samples</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudPaper Elevation="0" Class="pa-2 text-center" Style="background: var(--mud-palette-success-lighten);">
                                    <MudText Typo="Typo.h6">@_analysisResult!.SegmentsFound</MudText>
                                    <MudText Typo="Typo.caption">Segments</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudPaper Elevation="0" Class="pa-2 text-center" Style="background: var(--mud-palette-warning-lighten);">
                                    <MudText Typo="Typo.h6">@_analysisResult!.ElementDrifts.Count</MudText>
                                    <MudText Typo="Typo.caption">Elements</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudPaper Elevation="0" Class="pa-2 text-center" Style="background: var(--mud-palette-secondary-lighten);">
                                    <MudText Typo="Typo.h6">@_analysisResult!.CorrectedSamples</MudText>
                                    <MudText Typo="Typo.caption">Corrected</MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <div style="height: 640px;">
                            <canvas id="driftChart" style="width:100%; height:100%"></canvas>
                        </div>

                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.h6" Class="mb-2">Element Drift Analysis</MudText>
                        <MudTable Items="@GetPagedElementDrifts()"
                                  Hover="true"
                                  Dense="true"
                                  FixedHeader="true"
                                  Height="260px"
                                  Breakpoint="Breakpoint.None"
                                  HorizontalScrollbar="true">
                            <HeaderContent>
                                <MudTh>Element</MudTh>
                                <MudTh>Initial Ratio</MudTh>
                                <MudTh>Final Ratio</MudTh>
                                <MudTh>Drift %</MudTh>
                                <MudTh>Slope</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Element</MudTd>
                                <MudTd>@context.InitialRatio.ToString("F4")</MudTd>
                                <MudTd>@context.FinalRatio.ToString("F4")</MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Color="@GetDriftColor(context.DriftPercent)">
                                        @context.DriftPercent.ToString("F2")%
                                    </MudChip>
                                </MudTd>
                                <MudTd>@context.Slope.ToString("F6")</MudTd>
                            </RowTemplate>
                        </MudTable>

                        @if (_totalCount > 0)
                        {
                            <div class="d-flex justify-center align-center mt-3 gap-4 change-flex-item">
                                <MudSelect T="int"
                                           Value="_pageSize"
                                           ValueChanged="OnPageSizeChanged"
                                           Label="Per Page"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Style="width: 110px;">
                                    <MudSelectItem Value="10">10</MudSelectItem>
                                    <MudSelectItem Value="20">20</MudSelectItem>
                                    <MudSelectItem Value="50">50</MudSelectItem>
                                    <MudSelectItem Value="100">100</MudSelectItem>
                                </MudSelect>

                                <MudPagination Count="@_totalPages"
                                               Selected="_currentPage"
                                               SelectedChanged="OnPageChanged"
                                               ShowFirstButton="true"
                                               ShowLastButton="true"
                                               BoundaryCount="1"
                                               MiddleCount="3" />
                            </div>
                        }
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

<style>
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.2);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .mud-table-cell {
        white-space: nowrap;
    }
</style>
