@page "/process/calibration-pro"
@using WebUI.Services
@inject ProjectService ProjectService
@inject PivotService PivotService
@using System.Text.Json
@using System.Linq
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@inject ILogger<CalibrationPro> _logger
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using MudBlazor

<style>
    /* استایل‌های اختصاصی برای شباهت ۱۰۰ درصدی به تصویر */
    .main-container { background-color: #f0f2f5; min-height: 100vh; padding: 15px; }
    .section-header { font-weight: bold; border-bottom: 1px solid #ddd; margin-bottom: 10px; padding-bottom: 5px; }
    .green-btn { background-color: #28a745 !important; color: white !important; text-transform: none; }
    .dark-green-btn { background-color: #1e7e34 !important; color: white !important; text-transform: none; }
    .red-btn { background-color: #dc3545 !important; color: white !important; text-transform: none; }
    .custom-card { border-radius: 4px; border: 1px solid #e0e0e0; height: 100%; background: white; }
    .form-label-small { font-size: 0.75rem; color: #666; }
</style>
<PageTitle>ICP - Calibration Pro</PageTitle>


<div class="main-container">
    <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4 mb-5">
            <MudPaper Elevation="0" Class="pa-4 mb-4 custom-card-all">
        <div class="justify-space-between align-center">
            <div class="mb-4">
                <MudText Typo="Typo.h4" Class="fw-bold h4-title">Calibration Pro</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary p-description">Advanced RM calibration and drift-correction tools</MudText>
            </div>
            <ProcessNav CurrentStep="calibrationpro" />
        </div>
    </MudPaper>

        <MudPaper Elevation="0" Class="pa-3 mb-3 custom-card d-flex align-center flex-wrap gap-2">
            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="fw-bold mr-2">Shared Settings</MudText>
            <MudSelect T="string"
                       Label="File"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Style="width:250px"
                       Value="_selectedFile"
                       ValueChanged="OnFileChanged">
                @foreach (var f in _files)
                {
                    <MudSelectItem Value="@f" />
                }
            </MudSelect>
            <MudSelect T="string"
                       Label="Element"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Style="width:150px"
                       Value="_selectedElement"
                       ValueChanged="OnElementChanged">
                @foreach (var el in _elements)
                {
                    <MudSelectItem Value="@el" />
                }
            </MudSelect>
            
            <MudText Class="mx-2">Current RM: <span style="color:#007bff; font-weight:bold;">@CurrentRmLabel</span></MudText>
            
            <MudButton Variant="Variant.Filled"
                       Class="dark-green-btn px-4"
                       OnClick="PrevRm">
                PREVIOUS RM
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Class="dark-green-btn px-4"
                       OnClick="NextRm">
                NEXT RM
            </MudButton>
            
            <MudTextField T="string"
                          Placeholder="e.g. CRM001, Check, Sample..."
                          Variant="Variant.Outlined"
                          Dense="true"
                          Margin="Margin.Dense"
                          Label="Filter Solution"
                          Style="width:200px"
                          Value="_filterSolution"
                          ValueChanged="OnFilterSolutionChanged" />
            
            <MudSpacer />
            
            <MudButton Variant="Variant.Filled"
                       Class="red-btn px-4"
                       OnClick="ResetAll">
                RESET ALL
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Class="green-btn px-4"
                       OnClick="RunCalibrationAsync">
                CALIBRATION
            </MudButton>
        </MudPaper>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudStack Spacing="2">
                    <MudPaper Class="pa-3 custom-card border-left-green">
                        <div class="section-header">CRM Verification</div>
                        <div class="d-flex gap-4 mb-2">
                            <MudCheckBox T="bool" Label="Certificate" Dense="true" Color="Color.Primary" Checked="true" />
                            <MudCheckBox T="bool" Label="CRM" Dense="true" Color="Color.Primary" Checked="true" />
                            <MudCheckBox T="bool" Label="Acceptable Range" Dense="true" Color="Color.Primary" Checked="true" />
                        </div>
                        <MudCheckBox T="bool" Label="Scale >50% Only" Dense="true" Class="mb-2" />
                        
                        <MudGrid Spacing="1">
                            <MudItem xs="6"><MudNumericField T="double" Label="Min" Value="0.0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="6"><MudNumericField T="double" Label="Max" Value="1000.0" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" /></MudItem>
                        </MudGrid>
                        
                        <div class="d-flex align-center gap-2 mt-2">
                            <MudTextField T="string"
                                          Label="Blank"
                                          Variant="Variant.Outlined"
                                          Dense="true"
                                          Margin="Margin.Dense"
                                          Value="@_previewBlank.ToString()"
                                          ValueChanged="UpdatePreviewBlank" />
                            <MudButton Variant="Variant.Filled"
                                       Class="dark-green-btn"
                                       Size="Size.Small"
                                       OnClick="ResetBlankAndScale">
                                Reset BS
                            </MudButton>
                        </div>
                        
                        <MudSlider T="double"
                                   Min="0"
                                   Max="2"
                                   Step="0.01"
                                   Color="Color.Primary"
                                   Class="mt-2"
                                   Value="@_previewScale"
                                   ValueChanged="UpdatePreviewScale">
                            Scale: @_previewScale.ToString("0.00")
                        </MudSlider>

                        <MudGrid Spacing="1" Class="mt-2">
                            <MudItem xs="4"><MudButton FullWidth="true" Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Ranges</MudButton></MudItem>
                            <MudItem xs="4"><MudButton FullWidth="true" Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Exclude</MudButton></MudItem>
                            <MudItem xs="4"><MudButton FullWidth="true" Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Select CRMs</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth="true" Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Undo CRM</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth="true" Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Correct CRM</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth="true" Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Apply Our Model</MudButton></MudItem>
                            <MudItem xs="6"><MudButton FullWidth="true" Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Report</MudButton></MudItem>
                        </MudGrid>
                    </MudPaper>

                    <MudPaper Class="pa-3 custom-card" Style="background-color: #f9fff9;">
                        <div class="section-header">RM Drift Correction</div>
                        <MudGrid Spacing="1" Class="align-end">
                            <MudItem xs="5"><MudTextField T="string" Label="Keyword" Value="@("RM")" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" /></MudItem>
                            <MudItem xs="3"><MudButton Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Check RM</MudButton></MudItem>
                            <MudItem xs="4"><MudButton Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Reset to Original</MudButton></MudItem>
                        </MudGrid>
                        
                        <div class="d-flex gap-2 mt-2">
                            <MudCheckBox T="bool" Label="Per File RM Reference" Dense="true" Checked="true" />
                            <MudCheckBox T="bool" Label="Global Optimize" Dense="true" />
                        </div>
                        <MudCheckBox T="bool" Label="Stepwise Changes" Dense="true" />

                        <div class="d-flex align-center gap-2 mt-2">
                            <MudNumericField T="double" Label="Manual Slope" Value="-0.00122325" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                            <MudButton Variant="Variant.Filled" Class="dark-green-btn">Apply Slope</MudButton>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="fw-bold">Current Slope: -0.0012233</MudText>

                        <MudGrid Spacing="1" Class="mt-2">
                            <MudItem xs="4"><MudButton FullWidth="true" Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Auto Flat</MudButton></MudItem>
                            <MudItem xs="4"><MudButton FullWidth="true" Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Auto Zero Slope</MudButton></MudItem>
                            <MudItem xs="4"><MudButton FullWidth="true" Variant="Variant.Filled" Class="dark-green-btn" Size="Size.Small">Undo RM</MudButton></MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudStack Spacing="2">
                    <MudPaper Class="pa-3 custom-card">
                        <div class="section-header">RM Points — Current RM Only</div>
                        <MudTable Items="@VisibleRmPoints" Dense="true" Hover="true" Bordered="true" FixedHeader="true" Height="350px">
                            <HeaderContent>
                                <MudTh>RM Label</MudTh>
                                <MudTh>File</MudTh>
                                <MudTh>Next RM</MudTh>
                                <MudTh>Type</MudTh>
                                <MudTh>Original Value</MudTh>
                                <MudTh>Current Value</MudTh>
                                <MudTh>Ratio</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Label</MudTd>
                                <MudTd>File 1</MudTd>
                                <MudTd>@GetNextRmLabel(context)</MudTd>
                                <MudTd><span style="color:green; font-weight:bold;">Base</span></MudTd>
                                <MudTd>@FormatValue(context.Orig)</MudTd>
                                <MudTd>@FormatValue(context.Curr)</MudTd>
                                <MudTd>@GetRatio(context)</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>

                    <MudPaper Class="pa-3 custom-card">
                        <div class="section-header">All Acquisition Data — Original + New Value</div>
                        <MudTable Items="@(new List<string>())" Dense="true" Bordered="true" Height="250px" Placeholder="No data available">
                            <HeaderContent>
                                <MudTh>Solution Label</MudTh>
                                <MudTh>Original Value</MudTh>
                                <MudTh>Corrected Value</MudTh>
                            </HeaderContent>
                        </MudTable>
                    </MudPaper>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudStack Spacing="2">
                    <MudPaper Class="pa-3 custom-card">
                        <MudText Typo="Typo.h6">Full Drift Plot — All Samples + All RMs</MudText>
                    <div class="mt-2" style="height:360px;">
                        <canvas id="fullDriftChart" style="width:100%;height:100%;"></canvas>
                    </div>
                    </MudPaper>

                    <MudPaper Class="pa-3 custom-card">
                       <MudText Typo="Typo.h6">Verification Plot — CRM_Check Standards</MudText>
                    <div class="mt-2" style="height:200px;">
                        <canvas id="verificationChart" style="width:100%;height:100%;"></canvas>
                    </div>
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudContainer>
</div>

