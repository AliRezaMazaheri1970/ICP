@page "/process/crm"
@using Microsoft.AspNetCore.Components
@using WebUI.Services
@inject ProjectService ProjectService
@inject OptimizationService OptimizationService
@inject CrmService CrmService
@inject PivotService PivotService
@inject CorrectionService CorrectionService
@inject ISnackbar Snackbar

<PageTitle>ICP - CRM Calibration</PageTitle>
<NavigationLock OnBeforeInternalNavigation="OnBeforeNavigation" ConfirmExternalNavigation="_isLoading" />

@if (_isLoading)
{
    <div class="loading-overlay">
        <MudPaper Elevation="4" Class="pa-6 d-flex flex-column align-center">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Class="mt-4">Processing...</MudText>
        </MudPaper>
    </div>
}

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 crm-calibration">
    <MudText Typo="Typo.h5" Class="mb-3 fw-bold">Verification Plot</MudText>

    @if (_projectId == null)
    {
        <MudAlert Severity="Severity.Warning">
            Please select a project first.
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3" lg="3">
                <MudPaper Elevation="0" Class="control-panel">
                    <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold">Controls</MudText>

                    <MudSelect T="string"
                               Value="_focusElement"
                               ValueChanged="@(async (string v) => await SetFocusElement(v))"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Class="mb-2 bg-white">
                        @foreach (var element in _allElements)
                        {
                            <MudSelectItem Value="@element">@element</MudSelectItem>
                        }
                    </MudSelect>

                    <div class="d-flex gap-2 mb-2">
                        <MudButton Variant="Variant.Filled"
                                   FullWidth="true"
                                   Class="@(CanPrev ? "btn-green" : "btn-grey")"
                                   Disabled="@(!CanPrev)"
                                   OnClick="PrevElement">
                            Previous
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   FullWidth="true"
                                   Class="@(CanNext ? "btn-green" : "btn-grey")"
                                   Disabled="@(!CanNext)"
                                   OnClick="NextElement">
                            Next
                        </MudButton>
                    </div>

                    <div class="d-flex gap-2 flex-wrap mb-2">
                        <MudCheckBox T="bool"
                                     Checked="_showCertified"
                                     CheckedChanged="OnShowCertifiedChanged"
                                     Label="Certificate"
                                     Dense="true"
                                     Color="Color.Success" />
                        <MudCheckBox T="bool"
                                     Checked="_showCrm"
                                     CheckedChanged="OnShowCrmChanged"
                                     Label="CRM"
                                     Dense="true"
                                     Color="Color.Success" />
                    </div>

                    <MudCheckBox T="bool"
                                 Checked="_showAcceptableRange"
                                 CheckedChanged="OnShowRangeChanged"
                                 Label="Acceptable Range"
                                 Dense="true"
                                 Color="Color.Success"
                                 Class="mb-2" />

                    <div class="d-flex gap-2 mb-2">
                        <MudButton Variant="Variant.Filled" FullWidth="true" Class="btn-green" OnClick="OpenExcludeDialog">
                            Exclude from Correct
                        </MudButton>
                        <MudCheckBox T="bool"
                                     Checked="_scaleAbove50Only"
                                     CheckedChanged="OnScaleAbove50Changed"
                                     Label="Scale >50 only"
                                     Dense="true"
                                     Size="Size.Small" />
                    </div>

                    <div class="d-flex gap-2 mb-3">
                        <MudButton Variant="Variant.Filled" FullWidth="true" Class="btn-green" OnClick="OpenRangesDialog">Ranges</MudButton>
                        <MudButton Variant="Variant.Filled" FullWidth="true" Class="btn-green" OnClick="OpenSelectVerificationsDialog">Select Verifications</MudButton>
                    </div>

                    <MudText Typo="Typo.caption" Class="fw-bold">Scale Application Range</MudText>
                    <div class="scale-range-box mb-3">
                        <MudNumericField T="decimal?"
                                         Value="_scaleRangeMin"
                                         ValueChanged="OnRangeMinChanged"
                                         Placeholder="Min"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Immediate="true"
                                         Class="input-tiny" />
                        <MudNumericField T="decimal?"
                                         Value="_scaleRangeMax"
                                         ValueChanged="OnRangeMaxChanged"
                                         Placeholder="Max"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Immediate="true"
                                         Class="input-tiny" />
                        <MudText Typo="Typo.caption">@ScaleRangeDisplay</MudText>
                    </div>

                    <div class="d-flex gap-2 align-center mb-2">
                        <MudNumericField T="decimal?"
                                         Value="_previewBlank"
                                         ValueChanged="OnPreviewBlankChanged"
                                         Label="Preview Blank"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Immediate="true"
                                         Class="bg-white" />
                        <MudButton Variant="Variant.Filled" Class="btn-green" OnClick="ResetBlankAndScale">Reset Blank and Scale</MudButton>
                    </div>

                    <MudText Typo="Typo.caption">Preview Scale (0-2):</MudText>
                    <MudSlider T="double"
                               Value="_previewScale"
                               ValueChanged="OnPreviewScaleChanged"
                               Min="0" Max="2" Step="0.01"
                               Color="Color.Success"
                               Class="mb-2" />

                    <div class="info-text mb-3">
                        <MudText Typo="Typo.body2">Scale: @_previewScale.ToString("F2")</MudText>
                        <MudText Typo="Typo.body2">Blanks:</MudText>
                        @if (_blankLabelLines.Any())
                        {
                            @foreach (var line in _blankLabelLines)
                            {
                                <MudText Typo="Typo.caption" Class="info-sub">@line</MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="info-sub">None</MudText>
                        }
                        <MudText Typo="Typo.body2" Class="mt-1">Calibration: @_calibrationRange</MudText>
                    </div>

                    <MudTextField T="string"
                                  Value="_sampleFilter"
                                  ValueChanged="OnFilterChanged"
                                  Label="Filter Labels (e.g., rm):"
                                  Placeholder="Enter filter text"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Class="mb-3 bg-white" />

                    <div class="d-flex gap-2 mb-2">
                        <MudButton Variant="Variant.Filled" FullWidth="true" Class="btn-green" OnClick="OpenReportDialog">Report</MudButton>
                        <MudButton Variant="Variant.Filled" FullWidth="true" Class="btn-green" OnClick="ApplyRecommendedModel">Apply Our Model</MudButton>
                    </div>
                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Filled" FullWidth="true" Class="btn-green" OnClick="UndoManualAsync">Undo</MudButton>
                        <MudButton Variant="Variant.Filled" FullWidth="true" Class="btn-green" OnClick="ApplyManualAsync">Correct</MudButton>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="9" lg="9" Class="d-flex flex-column gap-3" Style="height: 80vh;">
                <MudPaper Class="plot-card" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Class="plot-title">
                        Verification Values for @_focusElement
                    </MudText>
                    <div class="plot-body">
                        <canvas id="calibrationChart" style="width: 100% !important; height: 100% !important;"></canvas>
                    </div>
                </MudPaper>

                <MudPaper Class="plot-card" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Class="plot-title">
                        Index vs Value
                    </MudText>
                    <div class="plot-body">
                        <canvas id="secondaryChart" style="width: 100% !important; height: 100% !important;"></canvas>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@* Acceptable Ranges Dialog *@
<MudDialog @bind-Visible="_rangesDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Class="me-2" />
            Acceptable Ranges Configuration
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
            Configure the acceptable range thresholds for different value magnitudes.
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="6">
                <MudNumericField @bind-Value="_rangeLow"
                                 Label="|x| < 10 (±absolute)"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Step="0.5M"
                                 HelperText="Absolute tolerance" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="_rangeMid"
                                 Label="10 = |x| < 100 (%)"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Step="1M"
                                 HelperText="Percentage tolerance" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="_rangeHigh1"
                                 Label="100 = |x| < 1000 (%)"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Step="1M" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="_rangeHigh2"
                                 Label="1000 = |x| < 10000 (%)"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Step="1M" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="_rangeHigh3"
                                 Label="10000 = |x| < 100000 (%)"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Step="1M" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="_rangeHigh4"
                                 Label="|x| = 100000 (%)"
                                 Variant="Variant.Outlined"
                                 Dense="true"
                                 Step="1M" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="ResetRanges">Reset to Default</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseRangesDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyRangesAsync">Apply</MudButton>
    </DialogActions>
</MudDialog>

@* Select Verifications Dialog *@
<MudDialog @bind-Visible="_selectVerificationsDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Select Verifications to Include</MudText>
    </TitleContent>
    <DialogContent>
        @if (!_crmLabelOptions.Any())
        {
            <MudAlert Severity="Severity.Info" Dense="true">No verifications available.</MudAlert>
        }
        else
        {
            <MudTable Items="@_crmLabelOptions" Dense="true" Hover="true" FixedHeader="true" Height="320px" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh>Verification</MudTh>
                    <MudTh>Include</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Verification">@context</MudTd>
                    <MudTd DataLabel="Include">
                        <MudCheckBox T="bool"
                                     Checked="@_includedCrmLabels.Contains(context)"
                                     CheckedChanged="@GetIncludeCallback(context)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="IncludeAllVerifications">Select All</MudButton>
        <MudButton Variant="Variant.Text" OnClick="ExcludeAllVerifications">Deselect All</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseSelectVerificationsDialog">Close</MudButton>
    </DialogActions>
</MudDialog>

@* Exclude Labels Dialog *@
<MudDialog @bind-Visible="_excludeDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Exclude from Correct</MudText>
    </TitleContent>
    <DialogContent>
        @if (!_excludeLabelRows.Any())
        {
            <MudAlert Severity="Severity.Info" Dense="true">No labels available.</MudAlert>
        }
        else
        {
            <MudTable Items="@_excludeLabelRows" Dense="true" Hover="true" FixedHeader="true" Height="360px" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh>Solution Label</MudTh>
                    <MudTh>Value</MudTh>
                    <MudTh>Exclude</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Solution Label">@context.SolutionLabel</MudTd>
                    <MudTd DataLabel="Value">@context.ValueDisplay</MudTd>
                    <MudTd DataLabel="Exclude">
                        <MudCheckBox T="bool"
                                     Checked="@_excludedLabels.Contains(context.SolutionLabel)"
                                     CheckedChanged="@GetExcludeCallback(context.SolutionLabel)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseExcludeDialog">Close</MudButton>
    </DialogActions>
</MudDialog>

@* Report Dialog *@
<MudDialog @bind-Visible="_reportDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Report</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">Recommended Blank: @_reportBlank.ToString("F3")</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">Recommended Scale: @_reportScale.ToString("F3")</MudText>
        @if (_result != null && !string.IsNullOrWhiteSpace(_focusElement) && _result.ElementOptimizations.TryGetValue(_focusElement, out var opt))
        {
            <MudText Typo="Typo.body2" Class="mb-1">Passed Before: @opt.PassedBefore</MudText>
            <MudText Typo="Typo.body2" Class="mb-1">Passed After: @opt.PassedAfter</MudText>
            <MudText Typo="Typo.body2">Avg Diff After: @opt.MeanDiffAfter.ToString("F2")%</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseReportDialog">Close</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyRecommendedModel">Apply Our Model</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.2);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .control-panel {
        background-color: #f4f4f4;
        padding: 12px;
        border-radius: 8px;
        height: 100%;
    }

    .btn-green {
        background-color: #388e3c !important;
        color: white !important;
        font-size: 0.75rem;
        text-transform: none;
        padding: 4px 8px;
    }

    .btn-grey {
        background-color: #e0e0e0 !important;
        color: black !important;
        font-size: 0.75rem;
        text-transform: none;
    }

    .input-tiny .mud-input-slot {
        font-size: 0.8rem;
        padding: 6px !important;
    }

    .bg-white {
        background-color: white;
    }

    .scale-range-box {
        display: flex;
        gap: 6px;
        align-items: center;
        padding: 6px;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: white;
    }

    .info-text {
        font-family: monospace;
        font-size: 0.8rem;
    }

    .info-sub {
        display: block;
        margin-left: 12px;
    }

    .plot-card {
        border: 1px solid #ccc;
        border-radius: 8px;
        background: white;
        padding: 12px;
        display: flex;
        flex-direction: column;
        min-height: 320px;
    }

    .plot-title {
        margin-bottom: 8px;
        font-weight: 600;
    }

    .plot-body {
        position: relative;
        width: 100%;
        flex: 1;
        min-height: 260px;
    }
</style>

