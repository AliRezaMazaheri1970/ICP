@using MudBlazor
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Acceptable Ranges</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="6" Class="d-flex align-center">
                <MudText Typo="Typo.body2">If |value| &lt; 10</MudText>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="RangeLow" Label="Absolute Tolerance" Adornment="Adornment.End" AdornmentText="m" Margin="Margin.Dense" Outlined="true" Step="0.1M" />
            </MudItem>

            <MudItem xs="6" Class="d-flex align-center">
                <MudText Typo="Typo.body2">If 10 &le; |value| &lt; 100</MudText>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="RangeMid" Label="Percentage (%)" Adornment="Adornment.End" AdornmentText="%" Margin="Margin.Dense" Outlined="true" Step="1M" />
            </MudItem>

            <MudItem xs="6" Class="d-flex align-center">
                <MudText Typo="Typo.body2">If 100 &le; |value| &lt; 1000</MudText>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="RangeHigh1" Label="Percentage (%)" Adornment="Adornment.End" AdornmentText="%" Margin="Margin.Dense" Outlined="true" Step="1M" />
            </MudItem>

            <MudItem xs="6" Class="d-flex align-center">
                <MudText Typo="Typo.body2">If 1000 &le; |value| &lt; 10000</MudText>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="RangeHigh2" Label="Percentage (%)" Adornment="Adornment.End" AdornmentText="%" Margin="Margin.Dense" Outlined="true" Step="1M" />
            </MudItem>

            <MudItem xs="6" Class="d-flex align-center">
                <MudText Typo="Typo.body2">If 10000 &le; |value| &lt; 100000</MudText>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="RangeHigh3" Label="Percentage (%)" Adornment="Adornment.End" AdornmentText="%" Margin="Margin.Dense" Outlined="true" Step="1M" />
            </MudItem>

            <MudItem xs="6" Class="d-flex align-center">
                <MudText Typo="Typo.body2">If |value| &ge; 100000</MudText>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="RangeHigh4" Label="Percentage (%)" Adornment="Adornment.End" AdornmentText="%" Margin="Margin.Dense" Outlined="true" Step="1M" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ResetRanges" Color="Color.Default">Reset</MudButton>
        <MudButton OnClick="Cancel" Color="Color.Secondary">Cancel</MudButton>
        <MudButton OnClick="Apply" Color="Color.Primary" Variant="Variant.Filled">Apply</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    // مقادیر ورودی (با مقادیر پیش فرض پاس داده شده از بیرون پر میشوند)
    [Parameter] public decimal RangeLow { get; set; }
    [Parameter] public decimal RangeMid { get; set; }
    [Parameter] public decimal RangeHigh1 { get; set; }
    [Parameter] public decimal RangeHigh2 { get; set; }
    [Parameter] public decimal RangeHigh3 { get; set; }
    [Parameter] public decimal RangeHigh4 { get; set; }

    void Cancel() => MudDialog.Cancel();

    void Apply()
    {
        // وقتی کاربر Apply میزند، تمام مقادیر جدید را به عنوان خروجی پاس میدهیم
        var resultData = new decimal[] { RangeLow, RangeMid, RangeHigh1, RangeHigh2, RangeHigh3, RangeHigh4 };
        MudDialog.Close(DialogResult.Ok(resultData));
    }

    void ResetRanges()
    {
        RangeLow = 2.0m;
        RangeMid = 20.0m;
        RangeHigh1 = 10.0m;
        RangeHigh2 = 8.0m;
        RangeHigh3 = 5.0m;
        RangeHigh4 = 3.0m;
        Snackbar.Add("Ranges reset to default values.", Severity.Info);
    }
}