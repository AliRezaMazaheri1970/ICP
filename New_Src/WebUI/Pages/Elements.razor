@page "/elements"
@using WebUI.Services
@inject ProjectService ProjectService
@inject ISnackbar Snackbar

<PageTitle>ICP - Elements</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="elements-page mt-4">
    @if (_projectId == null)
    {
        <MudAlert Severity="Severity.Warning">
            Please select a project first.
        </MudAlert>
    }
    else
    {
        <MudPaper Elevation="0" Class="elements-subtab">
            <MudText Typo="Typo.subtitle2" Class="elements-filter-label">Filter by Wavelength:</MudText>
            <MudSelect T="string"
                       Dense="true"
                       Variant="Variant.Outlined"
                       Value="_selectedWavelength"
                       ValueChanged="OnWavelengthChanged"
                       Class="elements-filter-select">
                @foreach (var wl in _availableWavelengths)
                {
                    <MudSelectItem Value="@wl">@wl</MudSelectItem>
                }
            </MudSelect>
        </MudPaper>

        <div class="elements-indicator"></div>

        <MudPaper Elevation="0" Class="elements-buttons">
            @if (_isLoading)
            {
                <div class="elements-loading">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                </div>
            }
            else if (_elementButtons.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="elements-empty">No elements found.</MudText>
            }
            else
            {
                <div class="elements-grid">
                    @foreach (var el in _elementButtons)
                    {
                        <MudButton Variant="@(el == _selectedElement ? Variant.Filled : Variant.Outlined)"
                                   Color="@(el == _selectedElement ? Color.Primary : Color.Default)"
                                   Size="Size.Small"
                                   DisableElevation="true"
                                   Class="elements-chip"
                                   OnClick="() => SelectElement(el)">
                            @el
                        </MudButton>
                    }
                </div>
            }
        </MudPaper>

        <MudPaper Elevation="0" Class="elements-details">
            @if (_isLoading)
            {
                <div class="elements-loading">
                    <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                </div>
            }
            else
            {
                <MudTable T="ElementDetailRow"
                          Items="_detailRows"
                          Dense="true"
                          Hover="true"
                          Striped="true"
                          FixedHeader="true"
                          Height="420px"
                          Breakpoint="Breakpoint.None"
                          HorizontalScrollbar="true">
                    <HeaderContent>
                        <MudTh>
                            <MudTableSortLabel SortBy="new Func<ElementDetailRow, object>(x => x.SolutionLabel)">
                                Solution Label
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortBy="new Func<ElementDetailRow, object>(x => x.Element)">
                                Element
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortBy="new Func<ElementDetailRow, object>(x => x.SortSolnConc)">
                                Soln Conc
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortBy="new Func<ElementDetailRow, object>(x => x.SortInt)">
                                Int
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortBy="new Func<ElementDetailRow, object>(x => x.Wavelength)">
                                Wavelength
                            </MudTableSortLabel>
                        </MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd DataLabel="Solution Label" Class="@(row.IsMessage ? "elements-msg" : "")">
                            @row.SolutionLabel
                        </MudTd>
                        <MudTd DataLabel="Element">@row.Element</MudTd>
                        <MudTd DataLabel="Soln Conc">@row.SolnConcDisplay</MudTd>
                        <MudTd DataLabel="Int">@row.IntDisplay</MudTd>
                        <MudTd DataLabel="Wavelength">@row.Wavelength</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    }
</MudContainer>
